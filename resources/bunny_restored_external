#!/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
export PATH HOME=/var/root USER=root LOGNAME=root
mkdir -p /var/run /tmp /var/root/.ssh 2>/dev/null || true
chmod 700 /var/root/.ssh 2>/dev/null || true

# ICH documents port 22 as the primary SSH service. A compatibility listener
# on 44 handles recovery-side clients that probe that port. Its failure does
# not prevent the primary service from starting.
if [ -x /usr/local/bin/dropbear ]; then
    /usr/local/bin/dropbear -R -E -p 44 >/dev/console 2>&1 &
    exec /usr/local/bin/dropbear -R -E -F -p 22
fi
echo "BUNNY: /usr/local/bin/dropbear missing" >/dev/console 2>&1
exit 127
