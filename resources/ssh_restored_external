#!/bin/sh
# Bunny SSH ramdisk entrypoint. This file is executed by the stock Mach-O
# /etc/rc.boot after the RestoreRamDisk has mounted itself as the root volume.
PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
export PATH
export HOME=/var/root
export USER=root
export LOGNAME=root
umask 0

echo "================================================================" >/dev/console 2>&1
echo "██    ██  █████  ██      ██ ██████  ██ ████████ ██    ██" >/dev/console 2>&1
echo "██    ██ ██   ██ ██      ██ ██   ██ ██    ██     ██  ██" >/dev/console 2>&1
echo "██    ██ ███████ ██      ██ ██   ██ ██    ██      ████" >/dev/console 2>&1
echo " ██  ██  ██   ██ ██      ██ ██   ██ ██    ██       ██" >/dev/console 2>&1
echo "  ████   ██   ██ ███████ ██ ██████  ██    ██       ██" >/dev/console 2>&1
echo "================================================================" >/dev/console 2>&1
echo "                    VALIDITY IS THE BEST" >/dev/console 2>&1
echo "================================================================" >/dev/console 2>&1

mkdir -p /var/run /tmp /var/root/.ssh /etc/dropbear 2>/dev/null || true
chmod 700 /var/root/.ssh /etc/dropbear 2>/dev/null || true

DROPBEAR=/usr/local/bin/dropbear.orig
[ -x "$DROPBEAR" ] || DROPBEAR=/usr/local/bin/dropbear

if [ ! -x "$DROPBEAR" ]; then
    echo "BUNNY SSH: ERROR: no Dropbear executable" >/dev/console 2>&1
    exit 127
fi

echo "BUNNY SSH: starting Dropbear on TCP 22 and TCP 44" >/dev/console 2>&1
exec "$DROPBEAR" -R -E -F -p 22 -p 44 >/dev/console 2>&1
