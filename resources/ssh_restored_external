#!/bin/sh
# SSHRD-style restored_external launcher for the A12/A13 restore ramdisk.
# Stock /etc/rc.boot execs this path directly.
mkdir -p /var/run
echo "================================================================" >/dev/console 2>&1
echo "      VVV     VVV    AAA    L   II   DDDD   II   TTTTT" >/dev/console 2>&1
echo "       VVV   VVV    A   A   L   II   D   D  II     T" >/dev/console 2>&1
echo "        VVV VVV     AAAAA   L   II   D   D  II     T" >/dev/console 2>&1
echo "         VVVVV      A   A   L   II   D   D  II     T" >/dev/console 2>&1
echo "          VVV       A   A   LLL II   DDDD   II     T" >/dev/console 2>&1
echo "================================================================" >/dev/console 2>&1
echo "                  VALIDITY IS THE BEST" >/dev/console 2>&1
echo "================================================================" >/dev/console 2>&1
echo "BUNNY SSHRD: starting Dropbear on TCP port 44" >/dev/console 2>&1
exec /usr/local/bin/dropbear -R -E -p 44 -F
